{
  "$defs": {
    "EvidenceSource": {
      "description": "Where the report came from, filled in when it was fetched from a CI platform.",
      "properties": {
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "job_commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Commit Sha"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "job_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Name"
        },
        "local_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local File"
        },
        "pipeline_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Id"
        },
        "pipeline_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Sha"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "title": "EvidenceSource",
      "type": "object"
    },
    "FindingsSummary": {
      "properties": {
        "by_severity": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Severity",
          "type": "object"
        },
        "suppressed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Findings excluded from total because they were suppressed/waived",
          "title": "Suppressed"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total"
      ],
      "title": "FindingsSummary",
      "type": "object"
    },
    "ScanScope": {
      "description": "What the scanner says it looked at.",
      "properties": {
        "components": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SBOM component count",
          "title": "Components"
        },
        "endpoints": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DAST: endpoints the scanner discovered and tested",
          "title": "Endpoints"
        },
        "files_scanned": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Files Scanned"
        },
        "resources": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IaC resources evaluated",
          "title": "Resources"
        },
        "scanned_paths": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Files/targets the scanner reports as scanned",
          "title": "Scanned Paths"
        },
        "skipped_paths": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Paths"
        }
      },
      "title": "ScanScope",
      "type": "object"
    },
    "ScanTarget": {
      "description": "The artifact a scan was run against (container image for Trivy).",
      "properties": {
        "artifact_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Name"
        },
        "artifact_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Type"
        },
        "image_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Id"
        },
        "repo_digests": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo Digests"
        },
        "repo_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo Tags"
        },
        "urls": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DAST: the target URLs the scanner says it scanned",
          "title": "Urls"
        }
      },
      "title": "ScanTarget",
      "type": "object"
    },
    "ScanType": {
      "enum": [
        "SAST",
        "CONTAINER",
        "DEPENDENCY",
        "SECRETS",
        "IAC",
        "SBOM",
        "DAST",
        "OTHER"
      ],
      "title": "ScanType",
      "type": "string"
    },
    "ScannerError": {
      "description": "An error the scanner reported about its own run (not a finding).",
      "properties": {
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "message"
      ],
      "title": "ScannerError",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/abdelrahman-eladwy/scanproof/main/schemas/evidence.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "findings": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindingsSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parse_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parse Error"
    },
    "parseable": {
      "description": "The report parsed as this tool's format",
      "title": "Parseable",
      "type": "boolean"
    },
    "present": {
      "description": "A report file was obtained",
      "title": "Present",
      "type": "boolean"
    },
    "report_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Bytes"
    },
    "report_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Sha256"
    },
    "results_reported": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The report contained a results section (even if empty)",
      "title": "Results Reported"
    },
    "scan_type": {
      "$ref": "#/$defs/ScanType"
    },
    "scanner_errors": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ScannerError"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None when the tool's format does not report errors",
      "title": "Scanner Errors"
    },
    "scanner_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Engine that produced the findings, e.g. CodeQL inside SARIF",
      "title": "Scanner Name"
    },
    "schema_version": {
      "const": "scanproof.dev/evidence/v1alpha1",
      "default": "scanproof.dev/evidence/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScanScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScanTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Version"
    }
  },
  "required": [
    "tool",
    "scan_type",
    "present",
    "parseable"
  ],
  "title": "scanproof evidence output",
  "type": "object",
  "x-scanproof-contract": "scanproof.dev/evidence/v1alpha1"
}
