{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.0.0",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "github-pat",
              "shortDescription": {
                "text": "Uncovered a GitHub Personal Access Token, potentially leading to unauthorized repository access and sensitive content exposure."
              }
            }
          ]
        }
      },
      "results": [
        {
          "message": {
            "text": "github-pat has detected secret for file /scan/config.yml."
          },
          "ruleId": "github-pat",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/scan/config.yml"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 19,
                  "endLine": 2,
                  "endColumn": 58,
                  "snippet": {
                    "text": "REDACTED"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "commitSha": "",
            "email": "",
            "author": "",
            "date": "",
            "commitMessage": ""
          },
          "properties": {
            "tags": []
          }
        }
      ]
    }
  ],
  "_scanproof_fixture": {
    "trimmed": true,
    "kept_results_per_run": 30,
    "original_results_per_run": [
      1
    ]
  }
}
